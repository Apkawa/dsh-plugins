{
  "name": "@apkawa/dsh-web-search-ddgs",
  "description": "ddgs-backed web search provider for dsh (default duckduckgo backend via a managed uv venv)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "ddgs-search.py"
  ],
  "dependencies": {
    "@apkawa/utils": "workspace:*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/schemastery": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "e2e:live": "node ../../scripts/e2e-live.ts --package dsh-web-search-ddgs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
